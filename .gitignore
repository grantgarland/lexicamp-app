# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

example

# generated native folders
/ios
/android

# Claude artifacts
.claude/.session_active
.claude/settings.local.json
.env.local

# Supabase (local CLI state & function secrets — deno.lock is intentionally committed)
supabase/.branches
supabase/.temp
supabase/.env
supabase/functions/.env

# Maestro screenshot output lands in the CWD you ran the flow from (repo root).
# The keepers get copied into assets/images/onboarding/ deliberately; the raw
# drops should never ride along in a commit.
/onboarding-*.png
