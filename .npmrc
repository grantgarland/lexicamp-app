registry=https://registry.npmjs.org

# eslint-plugin-react-native-a11y@3.5.1 (its latest) still declares a peer range
# of eslint "^3..^8" — it predates ESLint 9, which the project uses. The plugin's
# rules only touch APIs ESLint 9 kept, so it runs fine (wired in manually in
# eslint.config.js). npm has no per-package peer override, so relax peer-dep
# resolution project-wide; this keeps `npm install` and CI's `npm ci` green.
# Drop this once the plugin ships an ESLint 9 compatible release.
legacy-peer-deps=true
