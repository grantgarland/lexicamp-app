#!/bin/sh
# Keep generated artifacts in sync with the design-system source of truth.
#
# Independent drift/quality guards, each runs only when its inputs are staged:
#   1. Brand assets    (sync-brand-assets.js + managed PNGs)
#   2. Design tokens    (sync-tokens.mjs -> src/theme/tokens.generated.ts)
#   3. Token contrast   (check-contrast.mjs — WCAG AA over tokens.generated.ts, 3.11)
# Guards 1/2 re-sync from the design system and re-stage their outputs, so
# whatever gets committed matches the source of truth.
#
# Installed via `git config core.hooksPath .githooks` (wired up automatically
# by the package.json "prepare" script on npm install).
#
# Guard 0 lints the whole project before every commit (fast; mirrors the CI
# Lint step so red commits never leave the machine). Skip in an emergency with
# `git commit --no-verify` — CI will still catch it.

staged=$(git diff --cached --name-only)

# ── Guard 0: lint ────────────────────────────────────────────────────────────
echo "pre-commit: linting…"
if ! npm run --silent lint; then
  echo "pre-commit: lint failed; aborting commit. (Bypass once with --no-verify; CI still checks.)" >&2
  echo "pre-commit: if lint CRASHES with 'Cannot find native binding', reinstall deps: rm -rf node_modules && npm i" >&2
  exit 1
fi

# ── Guard 2: design tokens ───────────────────────────────────────────────────
# Trigger when the token sync script or its generated output is staged.
token_relevant=0
for f in scripts/sync-tokens.mjs src/theme/tokens.generated.ts; do
  if printf '%s\n' "$staged" | grep -qx "$f"; then token_relevant=1; break; fi
done
if [ "$token_relevant" -eq 1 ]; then
  if [ ! -d "../lexicamp-design-system/project/tokens" ]; then
    echo "pre-commit: lexicamp-design-system not found alongside the app; skipping token sync." >&2
  else
    echo "pre-commit: syncing design tokens from design system…"
    if ! node scripts/sync-tokens.mjs; then
      echo "pre-commit: token sync failed; aborting commit." >&2
      exit 1
    fi
    git add src/theme/tokens.generated.ts
  fi

  # ── Guard 3: WCAG contrast check ──────────────────────────────────────────
  # Runs against whatever tokens.generated.ts ends up staged above (synced or
  # not) — self-contained, no design-system dir needed.
  echo "pre-commit: checking token contrast (WCAG AA)…"
  if ! node scripts/check-contrast.mjs; then
    echo "pre-commit: contrast check failed; aborting commit." >&2
    exit 1
  fi
fi

# ── Guard 1: brand assets ────────────────────────────────────────────────────
MANAGED="assets/images/icon.png \
assets/images/android-icon-foreground.png \
assets/images/android-icon-background.png \
assets/images/favicon.png \
assets/images/android-icon-monochrome.png \
assets/images/splash-icon.png"

relevant=0
for f in scripts/sync-brand-assets.js $MANAGED; do
  if printf '%s\n' "$staged" | grep -qx "$f"; then
    relevant=1
    break
  fi
done
[ "$relevant" -eq 1 ] || exit 0

# The sync reads ../lexicamp-design-system; skip gracefully if it's absent.
if [ ! -d "../lexicamp-design-system/project/assets" ]; then
  echo "pre-commit: lexicamp-design-system not found alongside the app; skipping brand-asset sync." >&2
  exit 0
fi

echo "pre-commit: syncing brand assets from design system…"
if ! npm run --silent sync:assets; then
  echo "pre-commit: brand-asset sync failed; aborting commit." >&2
  exit 1
fi

# Re-stage only the managed assets the sync may have rewritten.
git add $MANAGED
exit 0
